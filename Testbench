`timescale 1ns/1ps

module tb_ram_memory;

    reg clk;
    reg we;

    reg [3:0] address;
    reg [7:0] data_in;

    wire [7:0] data_out;

    // Instantiate RAM
    ram_memory #(
        .DATA_WIDTH(8),
        .ADDR_WIDTH(4)
    ) DUT (
        .clk(clk),
        .we(we),
        .address(address),
        .data_in(data_in),
        .data_out(data_out)
    );

    // 10 ns clock
    always #5 clk = ~clk;

    // Write task
    task write_data(
        input [3:0] addr,
        input [7:0] data
    );
    begin
        @(negedge clk);

        we      = 1'b1;
        address = addr;
        data_in = data;

        @(posedge clk);

        $display(
            "Time=%0t | WRITE | Address=%h | Data=%h",
            $time, addr, data
        );

        we = 1'b0;
    end
    endtask

    // Read task
    task read_data(
        input [3:0] addr
    );
    begin
        @(negedge clk);

        we      = 1'b0;
        address = addr;

        @(posedge clk);

        #1;

        $display(
            "Time=%0t | READ  | Address=%h | Data=%h",
            $time, addr, data_out
        );
    end
    endtask

    initial begin

        $dumpfile("ram.vcd");
        $dumpvars(0, tb_ram_memory);

        clk     = 1'b0;
        we      = 1'b0;
        address = 4'h0;
        data_in = 8'h00;

        // Write data
        write_data(4'h0, 8'hA5);
        write_data(4'h3, 8'h3C);
        write_data(4'h7, 8'h55);

        // Read data
        read_data(4'h0);
        read_data(4'h3);
        read_data(4'h7);

        #20;

        $finish;

    end

endmodule
